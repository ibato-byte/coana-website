# Cloudflare Pages 用のヘッダー設定（netlify.toml の [[headers]] と同じ内容）
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ビルド時に取り込んだ外部写真（ファイル名に写真IDと幅を含むため内容は変わらない）
/images/remote/*
  Cache-Control: public, max-age=31536000, immutable

# すべてのページ：HTTPS を固定（HSTS）・使わないブラウザ機能を止める（SEO 見直し 2026-11-04）
/*
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# アイコン・共有画像は1日キャッシュ（毎回の再確認をなくして表示を速く）
/favicon*
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og-image.jpg
  Cache-Control: public, max-age=86400
